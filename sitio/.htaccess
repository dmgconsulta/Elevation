# Configuración para hostings Apache (cPanel, Hostinger, SiteGround…). Se ignora en otros servidores.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddCharset utf-8 .html .css .js
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# Caché: la página se revisa siempre; imágenes y videos se guardan un mes, CSS y JS una semana
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "config\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Forzar HTTPS (descomenta las 3 líneas cuando el dominio ya tenga certificado SSL)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
ErrorDocument 404 /404.html
