PORT=3000
NODE_ENV=production
# Obligatorio en producción: cadena larga aleatoria
SESSION_SECRET=
# Admin inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=
# Asistentes IA (sin clave responden en modo demo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# demo = cambio de plan instantáneo sin cobro. Para cobrar, integrar pasarela.
PAYMENTS_MODE=demo
# Carpeta persistente de la base SQLite
DATA_DIR=./data
